{
  "$about": "Initial CLI config. Refer to mAIcroverse repo for more help.",
  "baseUrl": "http://localhost:4321",
  "repoBaseUrl": "https://github.com/bloxez/maicroverse/tree/main/project",
  "defaultInstance": "maicro",
  "defaultInstanceKey": "your_default_instance_key",
  "projects": {
    "maicro": ""
  },
  "defaultInstanceConfig": {
    "apiKeys": [
      {
        "key": "OPENROUTER_API_KEY",
        "service": "OpenRouter",
        "description": "AI models",
        "value": "",
        "source": "custom"
      }
    ],
    "configOptions": [
      {
        "key": "AsyncJobConcurrency",
        "value": 10
      },
      {
        "key": "AsyncJobTriggers",
        "value": [
          {
            "event": "FILE_UPLOADED",
            "chainName": "DEFAULT_FILE_ANALYSIS",
            "description": "Automatically process new uploads via the default analysis chain.",
            "enabled": true,
            "source": "event"
          }
        ]
      },
      {
        "key": "CTX",
        "value": {}
      },
      {
        "key": "Features",
        "value": {
          "fetchAllowedHosts": "*"
        }
      },
      {
        "key": "maiql",
        "value": {
          "providers": {
            "openrouter": {
              "baseUrl": "https://openrouter.ai/api/v1",
              "enabled": true,
              "apiKeySecretName": "OPENROUTER_API_KEY"
            }
          },
          "models": {
            "simple": {
              "provider": "openrouter",
              "model": "nvidia/nemotron-nano-12b-v2-vl:free"
            },
            "embedding": {
              "provider": "openrouter",
              "model": "text-embedding-3-small",
              "dimensions": 1536
            },
            "file_analysis": {
              "provider": "openrouter",
              "model": "nvidia/nemotron-nano-12b-v2-vl:free"
            },
            "image_analysis": {
              "provider": "openrouter",
              "model": "nvidia/nemotron-nano-12b-v2-vl:free"
            }
          },
          "executors": {
            "axllm": {
              "enabled": true
            }
          },
          "document_types": {}
        }
      }
    ]
  }
}
